# App (usado no redirect do OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth (login só com Google). URL e publishable/anon key são públicas por desenho.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Alternativa legada — usada só se a publishable key não estiver definida.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend (orbita-go-back, NestJS). Recebe o access_token do Supabase como Bearer.
NEXT_PUBLIC_API_URL=http://localhost:3333

# Web Push (VAPID). Chave pública — a privada fica só no back.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BF6B3ErXb6_z2PP8LkAYOWHD3jPw8ftT1ygsAIXxWAwR_sRzcHS4dBvUmbtT9LlWBW0xBQX_fjrl6XkSDrYI9uU
